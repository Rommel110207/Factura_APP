<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="ni.edu.uam.practicahilospae.MonitorController"
      alignment="CENTER"
      spacing="20"
      prefWidth="580"
      prefHeight="480"
      style="-fx-background-color: #f4f6f9;">

    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <!-- Título Principal -->
    <Label text="Monitor Empresarial - NicaData Solutions"
           style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>

    <!-- TARJETA 1: CLIENTES -->
    <VBox spacing="10" style="-fx-background-color: white; -fx-background-radius: 8; -fx-padding: 15; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 6, 0, 0, 2);">
        <HBox alignment="CENTER_LEFT" spacing="10">
            <Label text="👥 Procesamiento de Clientes (100 registros)" style="-fx-font-weight: bold; -fx-font-size: 14px; -fx-text-fill: #34495e;"/>
        </HBox>

        <Label fx:id="lblEstadoClientes" text="Esperando inicio" style="-fx-text-fill: #7f8c8d;"/>

        <ProgressBar fx:id="barraClientes" progress="0" prefWidth="520" style="-fx-accent: #3498db;"/>

        <HBox alignment="CENTER_LEFT">
            <Label fx:id="lblPorcentajeClientes" text="0%" style="-fx-font-weight: bold; -fx-text-fill: #2980b9;"/>
        </HBox>

        <HBox spacing="8">
            <Button fx:id="btnIniciarClientes" text="Iniciar" onAction="#iniciarClientes" style="-fx-background-color: #2ecc71; -fx-text-fill: white;"/>
            <Button fx:id="btnPausarClientes" text="Pausar" onAction="#pausarClientes" disable="true" style="-fx-background-color: #f39c12; -fx-text-fill: white;"/>
            <Button fx:id="btnReanudarClientes" text="Reanudar" onAction="#reanudarClientes" disable="true" style="-fx-background-color: #3498db; -fx-text-fill: white;"/>
            <Button fx:id="btnReiniciarClientes" text="Reiniciar" onAction="#reiniciarClientes" disable="true" style="-fx-background-color: #e74c3c; -fx-text-fill: white;"/>
        </HBox>
    </VBox>

    <!-- TARJETA 2: PRODUCTOS -->
    <VBox spacing="10" style="-fx-background-color: white; -fx-background-radius: 8; -fx-padding: 15; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 6, 0, 0, 2);">
        <HBox alignment="CENTER_LEFT" spacing="10">
            <Label text="📦 Procesamiento de Productos (50 registros)" style="-fx-font-weight: bold; -fx-font-size: 14px; -fx-text-fill: #34495e;"/>
        </HBox>

        <Label fx:id="lblEstadoProductos" text="Esperando inicio" style="-fx-text-fill: #7f8c8d;"/>

        <ProgressBar fx:id="barraProductos" progress="0" prefWidth="520" style="-fx-accent: #9b59b6;"/>

        <HBox alignment="CENTER_LEFT">
            <Label fx:id="lblPorcentajeProductos" text="0%" style="-fx-font-weight: bold; -fx-text-fill: #8e44ad;"/>
        </HBox>

        <HBox spacing="8">
            <Button fx:id="btnIniciarProductos" text="Iniciar" onAction="#iniciarProductos" style="-fx-background-color: #2ecc71; -fx-text-fill: white;"/>
            <Button fx:id="btnPausarProductos" text="Pausar" onAction="#pausarProductos" disable="true" style="-fx-background-color: #f39c12; -fx-text-fill: white;"/>
            <Button fx:id="btnReanudarProductos" text="Reanudar" onAction="#reanudarProductos" disable="true" style="-fx-background-color: #3498db; -fx-text-fill: white;"/>
            <Button fx:id="btnReiniciarProductos" text="Reiniciar" onAction="#reiniciarProductos" disable="true" style="-fx-background-color: #e74c3c; -fx-text-fill: white;"/>
        </HBox>
    </VBox>

</VBox>
