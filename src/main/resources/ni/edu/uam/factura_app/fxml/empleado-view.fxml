<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<!--
  DISEÑO TEMA: Violeta / Índigo (único para Empleados)
  Diferente de: Productos (azul celeste) y Categorías (verde esmeralda)
-->
<BorderPane prefHeight="700.0" prefWidth="950.0"
            style="-fx-background-color: #f5f3ff;"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="ni.edu.uam.factura_app.controller.EmpleadoController">

    <!-- ═══════════════════ ENCABEZADO ═══════════════════ -->
    <top>
        <VBox style="-fx-background-color: #3b0764;">
            <!-- Banner principal -->
            <HBox alignment="CENTER_LEFT" spacing="16.0"
                  style="-fx-padding: 16 24 16 24;">
                <children>
                    <Label text="👥" style="-fx-font-size: 32px;" />
                    <VBox>
                        <Label text="Gestión de Empleados" textFill="WHITE">
                            <font><Font name="System Bold" size="22.0" /></font>
                        </Label>
                        <Label text="Administración del personal de la empresa"
                               style="-fx-text-fill: #c4b5fd; -fx-font-size: 11px;" />
                    </VBox>
                    <Region HBox.hgrow="ALWAYS" />
                    <Button mnemonicParsing="false" onAction="#cerrar"
                            text="✕ Cerrar"
                            style="-fx-background-color: #dc2626; -fx-text-fill: white;
                                   -fx-font-weight: bold; -fx-background-radius: 6;
                                   -fx-cursor: hand; -fx-padding: 6 14 6 14;" />
                </children>
            </HBox>

            <!-- Sub-barra de búsqueda + acciones -->
            <HBox alignment="CENTER_LEFT" spacing="10.0"
                  style="-fx-background-color: #4c1d95; -fx-padding: 10 24 10 24;">
                <children>
                    <TextField fx:id="txtBuscar" prefWidth="260.0"
                               promptText="🔍  Buscar por nombre..."
                               style="-fx-background-radius: 20; -fx-border-color: #c4b5fd;
                                      -fx-border-radius: 20; -fx-padding: 5 12 5 12;" />
                    <Button mnemonicParsing="false" onAction="#buscar"
                            text="Buscar"
                            style="-fx-background-color: #7c3aed; -fx-text-fill: white;
                                   -fx-font-weight: bold; -fx-background-radius: 20;
                                   -fx-cursor: hand; -fx-padding: 6 14 6 14;" />
                    <Region HBox.hgrow="ALWAYS" />
                    <Button mnemonicParsing="false" onAction="#guardar"
                            text="💾  Guardar"
                            style="-fx-background-color: #7c3aed; -fx-text-fill: white;
                                   -fx-font-weight: bold; -fx-background-radius: 6;
                                   -fx-cursor: hand; -fx-padding: 6 16 6 16;" />
                    <Button mnemonicParsing="false" onAction="#limpiar"
                            text="🧹  Limpiar"
                            style="-fx-background-color: #c4b5fd; -fx-text-fill: #3b0764;
                                   -fx-font-weight: bold; -fx-background-radius: 6;
                                   -fx-cursor: hand; -fx-padding: 6 16 6 16;" />
                </children>
            </HBox>
        </VBox>
    </top>

    <!-- ═══════════════════ CUERPO PRINCIPAL ═══════════════════ -->
    <center>
        <VBox spacing="16.0" BorderPane.alignment="CENTER">
            <padding><Insets top="20.0" right="20.0" bottom="20.0" left="20.0" /></padding>
            <children>

                <!-- TARJETA DE FORMULARIO -->
                <VBox spacing="14.0"
                      style="-fx-background-color: white;
                             -fx-padding: 20;
                             -fx-background-radius: 12;
                             -fx-border-color: #ddd6fe;
                             -fx-border-radius: 12;
                             -fx-border-width: 1.5;
                             -fx-effect: dropshadow(three-pass-box, rgba(59,7,100,0.08), 8, 0, 0, 4);">
                    <children>
                        <Label text="Datos del Empleado"
                               style="-fx-text-fill: #3b0764; -fx-font-size: 13px; -fx-font-weight: bold;" />

                        <!-- Línea separadora violeta -->
                        <Region prefHeight="2.0"
                                style="-fx-background-color: linear-gradient(to right, #7c3aed, transparent);" />

                        <GridPane hgap="16.0" vgap="12.0">
                            <columnConstraints>
                                <ColumnConstraints hgrow="SOMETIMES" maxWidth="130.0" minWidth="90.0" prefWidth="110.0" />
                                <ColumnConstraints hgrow="ALWAYS"    minWidth="10.0" />
                                <ColumnConstraints hgrow="SOMETIMES" maxWidth="130.0" minWidth="90.0" prefWidth="110.0" />
                                <ColumnConstraints hgrow="ALWAYS"    minWidth="10.0" />
                            </columnConstraints>
                            <rowConstraints>
                                <RowConstraints minHeight="38.0" prefHeight="38.0" />
                                <RowConstraints minHeight="38.0" prefHeight="38.0" />
                                <RowConstraints minHeight="38.0" prefHeight="38.0" />
                            </rowConstraints>
                            <children>
                                <!-- Fila 0 -->
                                <Label text="Nombres:"
                                       style="-fx-text-fill: #374151; -fx-font-weight: bold; -fx-font-size: 13px;" />
                                <TextField fx:id="txtNombres"
                                           promptText="Ej: Juan Carlos"
                                           style="-fx-background-radius: 6; -fx-border-color: #ddd6fe;
                                                  -fx-border-radius: 6; -fx-padding: 6 10 6 10;"
                                           GridPane.columnIndex="1" />

                                <Label text="Apellidos:"
                                       style="-fx-text-fill: #374151; -fx-font-weight: bold; -fx-font-size: 13px;"
                                       GridPane.columnIndex="2" />
                                <TextField fx:id="txtApellidos"
                                           promptText="Ej: Pérez Ruiz"
                                           style="-fx-background-radius: 6; -fx-border-color: #ddd6fe;
                                                  -fx-border-radius: 6; -fx-padding: 6 10 6 10;"
                                           GridPane.columnIndex="3" />

                                <!-- Fila 1 -->
                                <Label text="Cargo:"
                                       style="-fx-text-fill: #374151; -fx-font-weight: bold; -fx-font-size: 13px;"
                                       GridPane.rowIndex="1" />
                                <ComboBox fx:id="cmbCargo"
                                          prefWidth="200.0"
                                          promptText="Seleccione..."
                                          style="-fx-background-radius: 6; -fx-border-color: #ddd6fe; -fx-border-radius: 6;"
                                          GridPane.columnIndex="1" GridPane.rowIndex="1" />

                                <Label text="Contratación:"
                                       style="-fx-text-fill: #374151; -fx-font-weight: bold; -fx-font-size: 13px;"
                                       GridPane.columnIndex="2" GridPane.rowIndex="1" />
                                <DatePicker fx:id="dtpFechaContratacion"
                                            prefWidth="200.0"
                                            style="-fx-background-radius: 6; -fx-border-color: #ddd6fe; -fx-border-radius: 6;"
                                            GridPane.columnIndex="3" GridPane.rowIndex="1" />

                                <!-- Fila 2 -->
                                <Label text="Estado:"
                                       style="-fx-text-fill: #374151; -fx-font-weight: bold; -fx-font-size: 13px;"
                                       GridPane.rowIndex="2" />
                                <CheckBox fx:id="chkActivo" text="Activo"
                                          style="-fx-text-fill: #374151; -fx-font-size: 13px;"
                                          GridPane.columnIndex="1" GridPane.rowIndex="2" />
                            </children>
                        </GridPane>
                    </children>
                </VBox>

                <!-- TABLA -->
                <TableView fx:id="tblEmpleados" VBox.vgrow="ALWAYS"
                           style="-fx-background-radius: 10;
                                  -fx-border-color: #ddd6fe;
                                  -fx-border-radius: 10;
                                  -fx-border-width: 1.5;
                                  -fx-effect: dropshadow(three-pass-box, rgba(59,7,100,0.08), 8, 0, 0, 4);">
                    <columns>
                        <TableColumn fx:id="colId"        prefWidth="60.0"  text="ID" />
                        <TableColumn fx:id="colNombres"   prefWidth="160.0" text="Nombres" />
                        <TableColumn fx:id="colApellidos" prefWidth="160.0" text="Apellidos" />
                        <TableColumn fx:id="colCargo"     prefWidth="150.0" text="Cargo" />
                        <TableColumn fx:id="colFecha"     prefWidth="130.0" text="Contratación" />
                        <!-- colActivo: declarada para el binding pero oculta por solicitud del docente -->
                        <TableColumn fx:id="colActivo"    prefWidth="0.0"   text="Activo" visible="false" />
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                </TableView>

            </children>
        </VBox>
    </center>
</BorderPane>
