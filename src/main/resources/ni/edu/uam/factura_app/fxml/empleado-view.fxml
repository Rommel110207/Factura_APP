<?xml version="1.0" encoding="UTF-8"?>

import javafx.geometry.Insets?>
import javafx.scene.control.*?>
import javafx.scene.layout.*?>
import javafx.scene.text.Font?>

<VBox spacing="15.0" style="-fx-background-color: #f0fdf4;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ni.edu.uam.factura_app.controller.EmpleadoController">
    <children>
        <!-- HEADER -->
        <HBox alignment="CENTER_LEFT" spacing="20.0" style="-fx-background-color: #064e3b; -fx-padding: 15 24 15 24;">
            <children>
                <Label text="Empleados" textFill="WHITE" style="-fx-font-size: 24px; -fx-font-weight: bold;" />
                <Region HBox.hgrow="ALWAYS" />
                <Button mnemonicParsing="false" onAction="#cerrar" text="Cerrar" style="-fx-background-color: #ef4444; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6; -fx-cursor: hand; -fx-padding: 6 16 6 16;" />
            </children>
        </HBox>

        <!-- TOOLBAR -->
        <HBox alignment="CENTER_LEFT" spacing="10.0" style="-fx-background-color: #065f46; -fx-padding: 10 24 10 24;">
            <children>
                <TextField fx:id="txtBuscar" prefWidth="260.0" promptText="Buscar por nombre o apellido..." style="-fx-background-radius: 20; -fx-border-color: #6ee7b7; -fx-border-radius: 20; -fx-padding: 5 12 5 12;" />
                <Button mnemonicParsing="false" onAction="#buscar" text="Buscar" style="-fx-background-color: #10b981; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 20; -fx-cursor: hand; -fx-padding: 6 14 6 14;" />
                <Region HBox.hgrow="ALWAYS" />
                <Button mnemonicParsing="false" onAction="#guardar" text="Guardar" style="-fx-background-color: #10b981; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6; -fx-cursor: hand; -fx-padding: 6 16 6 16;" />
                <Button mnemonicParsing="false" onAction="#limpiar" text="Limpiar" style="-fx-background-color: #6ee7b7; -fx-text-fill: #064e3b; -fx-font-weight: bold; -fx-background-radius: 6; -fx-cursor: hand; -fx-padding: 6 16 6 16;" />
                <Button mnemonicParsing="false" onAction="#eliminar" text="Eliminar" style="-fx-background-color: #fee2e2; -fx-text-fill: #dc2626; -fx-font-weight: bold; -fx-background-radius: 6; -fx-cursor: hand; -fx-padding: 6 16 6 16;" />
            </children>
        </HBox>

        <HBox spacing="15.0" VBox.vgrow="ALWAYS">
            <VBox.margin>
                <Insets bottom="15.0" left="15.0" right="15.0" />
            </VBox.margin>
            <children>
                <!-- FORM -->
                <VBox prefWidth="400.0" spacing="15.0" style="-fx-background-color: white; -fx-background-radius: 10; -fx-border-color: #d1fae5; -fx-border-radius: 10; -fx-padding: 20;">
                    <children>
                        <Label text="Datos del Empleado" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #064e3b;" />
                        <GridPane vgap="15.0" hgap="10.0">
                            <columnConstraints>
                                <ColumnConstraints hgrow="SOMETIMES" maxWidth="120.0" minWidth="10.0" prefWidth="100.0" />
                                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" />
                            </columnConstraints>
                            <rowConstraints>
                                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                            </rowConstraints>
                            <children>
                                <Label text="Nombres:" style="-fx-font-weight: bold; -fx-text-fill: #064e3b;" GridPane.rowIndex="0" />
                                <TextField fx:id="txtNombres" promptText="Nombres" style="-fx-background-radius: 5; -fx-border-color: #a7f3d0; -fx-border-radius: 5;" GridPane.columnIndex="1" GridPane.rowIndex="0" />
                                
                                <Label text="Apellidos:" style="-fx-font-weight: bold; -fx-text-fill: #064e3b;" GridPane.rowIndex="1" />
                                <TextField fx:id="txtApellidos" promptText="Apellidos" style="-fx-background-radius: 5; -fx-border-color: #a7f3d0; -fx-border-radius: 5;" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                                
                                <Label text="Cargo:" style="-fx-font-weight: bold; -fx-text-fill: #064e3b;" GridPane.rowIndex="2" />
                                <ComboBox fx:id="cmbCargo" maxWidth="1.7976931348623157E308" promptText="Seleccione" style="-fx-background-radius: 5; -fx-border-color: #a7f3d0; -fx-border-radius: 5;" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                                
                                <Label text="Contratación:" style="-fx-font-weight: bold; -fx-text-fill: #064e3b;" GridPane.rowIndex="3" />
                                <DatePicker fx:id="dtpFechaContratacion" maxWidth="1.7976931348623157E308" style="-fx-background-radius: 5; -fx-border-color: #a7f3d0; -fx-border-radius: 5;" GridPane.columnIndex="1" GridPane.rowIndex="3" />
                                
                                <Label text="Estado:" style="-fx-font-weight: bold; -fx-text-fill: #064e3b;" GridPane.rowIndex="4" />
                                <CheckBox fx:id="chkActivo" text="Activo" GridPane.columnIndex="1" GridPane.rowIndex="4" />
                            </children>
                        </GridPane>
                    </children>
                </VBox>

                <!-- TABLE -->
                <VBox HBox.hgrow="ALWAYS" style="-fx-background-color: white; -fx-background-radius: 10; -fx-border-color: #d1fae5; -fx-border-radius: 10; -fx-padding: 10;">
                    <children>
                        <TableView fx:id="tblEmpleados" VBox.vgrow="ALWAYS" style="-fx-background-color: transparent;">
                            <columns>
                                <TableColumn fx:id="colId" prefWidth="50.0" text="ID" />
                                <TableColumn fx:id="colNombres" prefWidth="150.0" text="Nombres" />
                                <TableColumn fx:id="colApellidos" prefWidth="150.0" text="Apellidos" />
                                <TableColumn fx:id="colCargo" prefWidth="150.0" text="Cargo" />
                                <TableColumn fx:id="colFecha" prefWidth="100.0" text="Ingreso" />
                                <TableColumn fx:id="colActivo" prefWidth="70.0" text="Activo" />
                            </columns>
                            <placeholder>
                                <Label text="Tabla sin contenido" textFill="#9ca3af"/>
                            </placeholder>
                        </TableView>
                    </children>
                </VBox>
            </children>
        </HBox>
    </children>
</VBox>
