<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.text.Font?>
<VBox spacing="15.0" style="-fx-background-color: #f0fdf4;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ni.edu.uam.factura_app.controller.ProductoController">
    <children>
        <!-- HEADER -->
        <HBox alignment="CENTER_LEFT" spacing="20.0" style="-fx-background-color: #064e3b; -fx-padding: 15 24 15 24;">
            <children>
                <VBox>
                    <children>
                        <Label text="Gestión de Productos" textFill="WHITE" style="-fx-font-size: 24px; -fx-font-weight: bold;" />
                        <Label text="Administración de inventario y catálogo de productos" textFill="#a7f3d0" />
                    </children>
                </VBox>
                <Region HBox.hgrow="ALWAYS" />
                <Button mnemonicParsing="false" onAction="#cerrar" text="Cerrar" style="-fx-background-color: #ef4444; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6; -fx-cursor: hand; -fx-padding: 6 16 6 16;" />
            </children>
        </HBox>

        <!-- TOOLBAR / SEARCH / FILTERS -->
        <HBox alignment="CENTER_LEFT" spacing="10.0" style="-fx-background-color: #065f46; -fx-padding: 10 24 10 24;">
            <children>
                <TextField fx:id="txtBuscar" prefWidth="200.0" promptText="Buscar por código o nombre..." style="-fx-background-radius: 20; -fx-border-color: #6ee7b7; -fx-border-radius: 20; -fx-padding: 5 12 5 12;" />
                <ComboBox fx:id="cmbFiltroCategoria" prefWidth="180.0" promptText="Categoría" style="-fx-background-radius: 20;"/>
                <ComboBox fx:id="cmbFiltroEstado" prefWidth="120.0" promptText="Estado" style="-fx-background-radius: 20;"/>
                
                <Region HBox.hgrow="ALWAYS" />
                
                <Button mnemonicParsing="false" onAction="#guardar" text="Guardar" style="-fx-background-color: #10b981; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6; -fx-cursor: hand; -fx-padding: 6 16 6 16;" />
                <Button mnemonicParsing="false" onAction="#limpiar" text="Limpiar" style="-fx-background-color: #6ee7b7; -fx-text-fill: #064e3b; -fx-font-weight: bold; -fx-background-radius: 6; -fx-cursor: hand; -fx-padding: 6 16 6 16;" />
                <Button mnemonicParsing="false" onAction="#eliminar" text="Eliminar" style="-fx-background-color: #fee2e2; -fx-text-fill: #dc2626; -fx-font-weight: bold; -fx-background-radius: 6; -fx-cursor: hand; -fx-padding: 6 16 6 16;" />
            </children>
        </HBox>

        <HBox spacing="15.0" VBox.vgrow="ALWAYS">
            <VBox.margin>
                <Insets bottom="15.0" left="15.0" right="15.0" />
            </VBox.margin>
            <children>
                <!-- FORM -->
                <VBox prefWidth="500.0" spacing="15.0" style="-fx-background-color: white; -fx-background-radius: 10; -fx-border-color: #d1fae5; -fx-border-radius: 10; -fx-padding: 20;">
                    <children>
                        <Label text="Datos del Producto" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #064e3b;" />
                        <GridPane vgap="15.0" hgap="10.0">
                            <columnConstraints>
                                <ColumnConstraints hgrow="SOMETIMES" maxWidth="120.0" minWidth="10.0" prefWidth="100.0" />
                                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" />
                            </columnConstraints>
                            <rowConstraints>
                                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                            </rowConstraints>
                            <children>
                                <Label text="Código:" style="-fx-font-weight: bold; -fx-text-fill: #064e3b;" GridPane.rowIndex="0" />
                                <TextField fx:id="txtCodigo" promptText="Ej: PROD-001" style="-fx-background-radius: 5; -fx-border-color: #a7f3d0; -fx-border-radius: 5;" GridPane.columnIndex="1" GridPane.rowIndex="0" />

                                <Label text="Nombre:" style="-fx-font-weight: bold; -fx-text-fill: #064e3b;" GridPane.rowIndex="1" />
                                <TextField fx:id="txtNombre" promptText="Nombre del producto" style="-fx-background-radius: 5; -fx-border-color: #a7f3d0; -fx-border-radius: 5;" GridPane.columnIndex="1" GridPane.rowIndex="1" />

                                <Label text="Categoría:" style="-fx-font-weight: bold; -fx-text-fill: #064e3b;" GridPane.rowIndex="2" />
                                <ComboBox fx:id="cmbCategoria" maxWidth="1.7976931348623157E308" promptText="Seleccione" style="-fx-background-radius: 5; -fx-border-color: #a7f3d0; -fx-border-radius: 5;" GridPane.columnIndex="1" GridPane.rowIndex="2" />

                                <Label text="Precio:" style="-fx-font-weight: bold; -fx-text-fill: #064e3b;" GridPane.rowIndex="3" />
                                <TextField fx:id="txtPrecio" promptText="0.00" style="-fx-background-radius: 5; -fx-border-color: #a7f3d0; -fx-border-radius: 5;" GridPane.columnIndex="1" GridPane.rowIndex="3" />

                                <Label text="Existencia:" style="-fx-font-weight: bold; -fx-text-fill: #064e3b;" GridPane.rowIndex="4" />
                                <TextField fx:id="txtExistencia" promptText="0" style="-fx-background-radius: 5; -fx-border-color: #a7f3d0; -fx-border-radius: 5;" GridPane.columnIndex="1" GridPane.rowIndex="4" />

                                <Label text="Estado:" style="-fx-font-weight: bold; -fx-text-fill: #064e3b;" GridPane.rowIndex="5" />
                                <CheckBox fx:id="chkActivo" text="Activo" GridPane.columnIndex="1" GridPane.rowIndex="5" />
                            </children>
                        </GridPane>
                    </children>
                </VBox>

                <!-- IMAGE PANEL -->
                <VBox alignment="TOP_CENTER" prefWidth="250.0" spacing="15.0" style="-fx-background-color: white; -fx-background-radius: 10; -fx-border-color: #d1fae5; -fx-border-radius: 10; -fx-padding: 20;">
                    <children>
                        <Label text="Vista Previa" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #064e3b;" />
                        <VBox alignment="CENTER" prefHeight="200.0" prefWidth="200.0" style="-fx-border-color: #a7f3d0; -fx-border-radius: 10; -fx-background-color: #f0fdf4; -fx-background-radius: 10;">
                            <children>
                                <ImageView fx:id="imgProducto" fitHeight="180.0" fitWidth="180.0" pickOnBounds="true" preserveRatio="true" />
                            </children>
                        </VBox>
                        <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#seleccionarImagen" text="Seleccionar Imagen" style="-fx-background-color: #10b981; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6; -fx-cursor: hand; -fx-padding: 8;" />
                    </children>
                </VBox>
            </children>
        </HBox>

        <!-- TABLE -->
        <VBox VBox.vgrow="ALWAYS" style="-fx-background-color: white; -fx-background-radius: 10; -fx-border-color: #d1fae5; -fx-border-radius: 10; -fx-padding: 10;">
            <VBox.margin>
                <Insets bottom="15.0" left="15.0" right="15.0" top="0.0" />
            </VBox.margin>
            <children>
                <TableView fx:id="tblProductos" VBox.vgrow="ALWAYS" style="-fx-background-color: transparent;">
                    <columns>
                        <TableColumn fx:id="colImagen" prefWidth="70.0" text="Img" />
                        <TableColumn fx:id="colCodigo" prefWidth="100.0" text="Código" />
                        <TableColumn fx:id="colNombre" prefWidth="200.0" text="Nombre" />
                        <TableColumn fx:id="colCategoria" prefWidth="140.0" text="Categoría" />
                        <TableColumn fx:id="colPrecio" prefWidth="110.0" text="Precio" />
                        <TableColumn fx:id="colExistencia" prefWidth="90.0" text="Stock" />
                        <TableColumn fx:id="colActivo" prefWidth="0.0" text="Activo" visible="false" />
                    </columns>
                    <placeholder>
                        <Label text="Tabla sin contenido" textFill="#9ca3af"/>
                    </placeholder>
                </TableView>
            </children>
        </VBox>
    </children>
</VBox>
