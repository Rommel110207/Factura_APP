<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<!--
  DISEÑO TEMA: Azul Real / Marino (único para Productos)
  Diferente de: Categorías (verde esmeralda) y Empleados (violeta/índigo)
-->
<BorderPane prefHeight="740.0" prefWidth="1000.0"
            style="-fx-background-color: #eff6ff;"
            xmlns="http://javafx.com/javafx/17.0.12"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="ni.edu.uam.factura_app.controller.ProductoController">

    <!-- ═══════════════════ ENCABEZADO ═══════════════════ -->
    <top>
        <VBox style="-fx-background-color: #1e3a5f;">
            <!-- Banner principal -->
            <HBox alignment="CENTER_LEFT" spacing="16.0"
                  style="-fx-padding: 16 24 16 24;">
                <children>
                    <Label text="📦" style="-fx-font-size: 32px;" />
                    <VBox>
                        <Label text="Gestión de Productos" textFill="WHITE">
                            <font><Font name="System Bold" size="22.0" /></font>
                        </Label>
                        <Label text="Administración de inventario y catálogo de productos"
                               style="-fx-text-fill: #93c5fd; -fx-font-size: 11px;" />
                    </VBox>
                    <Region HBox.hgrow="ALWAYS" />
                    <Button mnemonicParsing="false" onAction="#cerrar"
                            text="✕ Cerrar"
                            style="-fx-background-color: #dc2626; -fx-text-fill: white;
                                   -fx-font-weight: bold; -fx-background-radius: 6;
                                   -fx-cursor: hand; -fx-padding: 6 14 6 14;" />
                </children>
            </HBox>

            <!-- Sub-barra de acciones rápidas y búsqueda -->
            <HBox alignment="CENTER_LEFT" spacing="10.0"
                  style="-fx-background-color: #1e40af; -fx-padding: 10 24 10 24;">
                <children>
                    <TextField fx:id="txtBuscar" prefWidth="260.0"
                               promptText="🔍  Buscar por código o nombre..."
                               style="-fx-background-radius: 20; -fx-border-color: #93c5fd;
                                      -fx-border-radius: 20; -fx-padding: 5 12 5 12;" />
                    <Button mnemonicParsing="false" onAction="#buscar"
                            text="Buscar"
                            style="-fx-background-color: #3b82f6; -fx-text-fill: white;
                                   -fx-font-weight: bold; -fx-background-radius: 20;
                                   -fx-cursor: hand; -fx-padding: 6 14 6 14;" />
                    <Region HBox.hgrow="ALWAYS" />
                    <Button mnemonicParsing="false" onAction="#guardar"
                            text="💾  Guardar"
                            style="-fx-background-color: #3b82f6; -fx-text-fill: white;
                                   -fx-font-weight: bold; -fx-background-radius: 6;
                                   -fx-cursor: hand; -fx-padding: 6 16 6 16;" />
                    <Button mnemonicParsing="false" onAction="#limpiar"
                            text="🧹  Limpiar"
                            style="-fx-background-color: #93c5fd; -fx-text-fill: #1e3a5f;
                                   -fx-font-weight: bold; -fx-background-radius: 6;
                                   -fx-cursor: hand; -fx-padding: 6 16 6 16;" />
                </children>
            </HBox>
        </VBox>
    </top>

    <!-- ═══════════════════ CUERPO PRINCIPAL ═══════════════════ -->
    <center>
        <VBox spacing="16.0" BorderPane.alignment="CENTER">
            <padding>
                <Insets top="20.0" right="20.0" bottom="20.0" left="20.0" />
            </padding>
            <children>

                <!-- Fila superior: Formulario + Vista Previa -->
                <HBox spacing="16.0">
                    <children>

                        <!-- TARJETA FORMULARIO (izquierda) -->
                        <VBox spacing="12.0" HBox.hgrow="ALWAYS"
                              style="-fx-background-color: white;
                                     -fx-padding: 20;
                                     -fx-background-radius: 12;
                                     -fx-border-color: #bfdbfe;
                                     -fx-border-radius: 12;
                                     -fx-border-width: 1.5;
                                     -fx-effect: dropshadow(three-pass-box, rgba(30,58,95,0.08), 8, 0, 0, 4);">
                            <children>
                                <Label text="Datos del Producto"
                                       style="-fx-text-fill: #1e3a5f; -fx-font-size: 13px; -fx-font-weight: bold;" />
                                <Region prefHeight="2.0"
                                        style="-fx-background-color: linear-gradient(to right, #3b82f6, transparent);" />

                                <GridPane hgap="14.0" vgap="12.0">
                                    <columnConstraints>
                                        <ColumnConstraints hgrow="SOMETIMES" maxWidth="120.0" minWidth="80.0" prefWidth="100.0" />
                                        <ColumnConstraints hgrow="ALWAYS" minWidth="10.0" />
                                    </columnConstraints>
                                    <rowConstraints>
                                        <RowConstraints minHeight="36.0" prefHeight="36.0" />
                                        <RowConstraints minHeight="36.0" prefHeight="36.0" />
                                        <RowConstraints minHeight="36.0" prefHeight="36.0" />
                                        <RowConstraints minHeight="36.0" prefHeight="36.0" />
                                        <RowConstraints minHeight="36.0" prefHeight="36.0" />
                                        <RowConstraints minHeight="36.0" prefHeight="36.0" />
                                    </rowConstraints>
                                    <children>
                                        <Label text="Código:"
                                               style="-fx-text-fill: #374151; -fx-font-weight: bold; -fx-font-size: 13px;" />
                                        <TextField fx:id="txtCodigo"
                                                   promptText="Ej: PROD-001"
                                                   style="-fx-background-radius: 6; -fx-border-color: #bfdbfe; -fx-border-radius: 6; -fx-padding: 5 10 5 10;"
                                                   GridPane.columnIndex="1" />

                                        <Label text="Nombre:"
                                               style="-fx-text-fill: #374151; -fx-font-weight: bold; -fx-font-size: 13px;"
                                               GridPane.rowIndex="1" />
                                        <TextField fx:id="txtNombre"
                                                   promptText="Nombre del producto"
                                                   style="-fx-background-radius: 6; -fx-border-color: #bfdbfe; -fx-border-radius: 6; -fx-padding: 5 10 5 10;"
                                                   GridPane.columnIndex="1" GridPane.rowIndex="1" />

                                        <Label text="Categoría:"
                                               style="-fx-text-fill: #374151; -fx-font-weight: bold; -fx-font-size: 13px;"
                                               GridPane.rowIndex="2" />
                                        <ComboBox fx:id="cmbCategoria" prefWidth="250.0"
                                                  style="-fx-background-radius: 6; -fx-border-color: #bfdbfe; -fx-border-radius: 6;"
                                                  GridPane.columnIndex="1" GridPane.rowIndex="2" />

                                        <Label text="Precio:"
                                               style="-fx-text-fill: #374151; -fx-font-weight: bold; -fx-font-size: 13px;"
                                               GridPane.rowIndex="3" />
                                        <TextField fx:id="txtPrecio"
                                                   promptText="0.00"
                                                   style="-fx-background-radius: 6; -fx-border-color: #bfdbfe; -fx-border-radius: 6; -fx-padding: 5 10 5 10;"
                                                   GridPane.columnIndex="1" GridPane.rowIndex="3" />

                                        <Label text="Existencia:"
                                               style="-fx-text-fill: #374151; -fx-font-weight: bold; -fx-font-size: 13px;"
                                               GridPane.rowIndex="4" />
                                        <TextField fx:id="txtExistencia"
                                                   promptText="0"
                                                   style="-fx-background-radius: 6; -fx-border-color: #bfdbfe; -fx-border-radius: 6; -fx-padding: 5 10 5 10;"
                                                   GridPane.columnIndex="1" GridPane.rowIndex="4" />

                                        <Label text="Estado:"
                                               style="-fx-text-fill: #374151; -fx-font-weight: bold; -fx-font-size: 13px;"
                                               GridPane.rowIndex="5" />
                                        <CheckBox fx:id="chkActivo" text="Activo"
                                                  style="-fx-text-fill: #374151; -fx-font-size: 13px;"
                                                  GridPane.columnIndex="1" GridPane.rowIndex="5" />
                                    </children>
                                </GridPane>
                            </children>
                        </VBox>

                        <!-- TARJETA VISTA PREVIA (derecha) -->
                        <VBox alignment="TOP_CENTER" prefWidth="220.0" spacing="14.0"
                              style="-fx-background-color: white;
                                     -fx-padding: 20;
                                     -fx-background-radius: 12;
                                     -fx-border-color: #bfdbfe;
                                     -fx-border-radius: 12;
                                     -fx-border-width: 1.5;
                                     -fx-effect: dropshadow(three-pass-box, rgba(30,58,95,0.08), 8, 0, 0, 4);">
                            <children>
                                <Label text="Vista Previa"
                                       style="-fx-text-fill: #1e3a5f; -fx-font-size: 13px; -fx-font-weight: bold;" />
                                <Region prefHeight="2.0"
                                        style="-fx-background-color: linear-gradient(to right, #3b82f6, transparent);" />

                                <!-- Marco para la imagen -->
                                <StackPane prefHeight="170.0" prefWidth="170.0"
                                           style="-fx-background-color: #eff6ff;
                                                  -fx-background-radius: 10;
                                                  -fx-border-color: #bfdbfe;
                                                  -fx-border-radius: 10;
                                                  -fx-border-width: 1.5;">
                                    <children>
                                        <ImageView fx:id="imgProducto"
                                                   fitHeight="160.0" fitWidth="160.0"
                                                   pickOnBounds="true" preserveRatio="true" />
                                    </children>
                                </StackPane>

                                <Button fx:id="btnImagen" mnemonicParsing="false"
                                        onAction="#seleccionarImagen"
                                        text="📷  Seleccionar Imagen"
                                        maxWidth="1.7976931348623157E308"
                                        style="-fx-background-color: #3b82f6; -fx-text-fill: white;
                                               -fx-font-weight: bold; -fx-background-radius: 6;
                                               -fx-cursor: hand; -fx-padding: 8 0 8 0;" />
                            </children>
                        </VBox>

                    </children>
                </HBox>

                <!-- TABLA -->
                <TableView fx:id="tblProductos" VBox.vgrow="ALWAYS"
                           style="-fx-background-radius: 10;
                                  -fx-border-color: #bfdbfe;
                                  -fx-border-radius: 10;
                                  -fx-border-width: 1.5;
                                  -fx-effect: dropshadow(three-pass-box, rgba(30,58,95,0.08), 8, 0, 0, 4);">
                    <columns>
                        <TableColumn fx:id="colImagen"     prefWidth="70.0"  text="Img" />
                        <TableColumn fx:id="colCodigo"     prefWidth="100.0" text="Código" />
                        <TableColumn fx:id="colNombre"     prefWidth="200.0" text="Nombre" />
                        <TableColumn fx:id="colCategoria"  prefWidth="140.0" text="Categoría" />
                        <TableColumn fx:id="colPrecio"     prefWidth="110.0" text="Precio" />
                        <TableColumn fx:id="colExistencia" prefWidth="90.0"  text="Stock" />
                        <!-- colActivo: declarada para el binding pero oculta por solicitud del docente -->
                        <TableColumn fx:id="colActivo"     prefWidth="0.0"   text="Activo" visible="false" />
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                </TableView>

            </children>
        </VBox>
    </center>
</BorderPane>
