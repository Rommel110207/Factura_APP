<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<!--
  DISEÑO TEMA: Verde Esmeralda (único para Categorías)
  Diferente de: Productos (azul celeste) y Empleados (violeta/morado)
-->
<BorderPane prefHeight="650.0" prefWidth="820.0"
            style="-fx-background-color: #f0fdf4;"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="ni.edu.uam.factura_app.controller.CategoriaController">

    <!-- ═══════════════════ ENCABEZADO ═══════════════════ -->
    <top>
        <VBox style="-fx-background-color: #064e3b;">
            <!-- Banner principal -->
            <HBox alignment="CENTER_LEFT" spacing="16.0"
                  style="-fx-padding: 16 24 16 24;">
                <children>
                    <Label text="🏷️" style="-fx-font-size: 32px;" />
                    <VBox>
                        <Label text="Gestión de Categorías" textFill="WHITE">
                            <font><Font name="System Bold" size="22.0" /></font>
                        </Label>
                        <Label text="Clasificación para la organización del inventario"
                               style="-fx-text-fill: #6ee7b7; -fx-font-size: 11px;" />
                    </VBox>
                    <Region HBox.hgrow="ALWAYS" />
                    <Button mnemonicParsing="false" onAction="#cerrar"
                            text="✕ Cerrar"
                            style="-fx-background-color: #dc2626; -fx-text-fill: white;
                                   -fx-font-weight: bold; -fx-background-radius: 6;
                                   -fx-cursor: hand; -fx-padding: 6 14 6 14;" />
                </children>
            </HBox>

            <!-- Barra de búsqueda + acciones integrada en el header -->
            <HBox alignment="CENTER_LEFT" spacing="10.0"
                  style="-fx-background-color: #065f46; -fx-padding: 10 24 10 24;">
                <children>
                    <TextField fx:id="txtBuscar" prefWidth="260.0"
                               promptText="🔍  Buscar categoría..."
                               style="-fx-background-radius: 20; -fx-border-color: #6ee7b7;
                                      -fx-border-radius: 20; -fx-padding: 5 12 5 12;" />
                    <Button mnemonicParsing="false" onAction="#buscar"
                            text="Buscar"
                            style="-fx-background-color: #10b981; -fx-text-fill: white;
                                   -fx-font-weight: bold; -fx-background-radius: 20;
                                   -fx-cursor: hand; -fx-padding: 6 14 6 14;" />
                    <Region HBox.hgrow="ALWAYS" />
                    <Button mnemonicParsing="false" onAction="#guardar"
                            text="💾  Guardar"
                            style="-fx-background-color: #10b981; -fx-text-fill: white;
                                   -fx-font-weight: bold; -fx-background-radius: 6;
                                   -fx-cursor: hand; -fx-padding: 6 16 6 16;" />
                    <Button mnemonicParsing="false" onAction="#limpiar"
                            text="🧹  Limpiar"
                            style="-fx-background-color: #6ee7b7; -fx-text-fill: #064e3b;
                                   -fx-font-weight: bold; -fx-background-radius: 6;
                                   -fx-cursor: hand; -fx-padding: 6 16 6 16;" />
                </children>
            </HBox>
        </VBox>
    </top>

    <!-- ═══════════════════ CUERPO PRINCIPAL ═══════════════════ -->
    <center>
        <VBox spacing="16.0" BorderPane.alignment="CENTER">
            <padding><Insets top="20.0" right="20.0" bottom="20.0" left="20.0" /></padding>
            <children>

                <!-- TARJETA DE FORMULARIO -->
                <VBox spacing="14.0"
                      style="-fx-background-color: white;
                             -fx-padding: 20;
                             -fx-background-radius: 12;
                             -fx-border-color: #a7f3d0;
                             -fx-border-radius: 12;
                             -fx-border-width: 1.5;
                             -fx-effect: dropshadow(three-pass-box, rgba(6,78,59,0.08), 8, 0, 0, 4);">
                    <children>
                        <Label text="Datos de la Categoría"
                               style="-fx-text-fill: #064e3b; -fx-font-size: 13px; -fx-font-weight: bold;" />

                        <!-- Línea separadora verde -->
                        <Region prefHeight="2.0"
                                style="-fx-background-color: linear-gradient(to right, #10b981, transparent);" />

                        <GridPane hgap="16.0" vgap="12.0">
                            <columnConstraints>
                                <ColumnConstraints hgrow="SOMETIMES" maxWidth="130.0" minWidth="80.0" prefWidth="110.0" />
                                <ColumnConstraints hgrow="ALWAYS" minWidth="10.0" />
                                <ColumnConstraints hgrow="SOMETIMES" maxWidth="130.0" minWidth="80.0" prefWidth="110.0" />
                                <ColumnConstraints hgrow="ALWAYS" minWidth="10.0" />
                            </columnConstraints>
                            <rowConstraints>
                                <RowConstraints minHeight="38.0" prefHeight="38.0" />
                            </rowConstraints>
                            <children>
                                <Label text="Nombre:" style="-fx-text-fill: #374151; -fx-font-weight: bold; -fx-font-size: 13px;" />
                                <TextField fx:id="txtNombre"
                                           promptText="Ej: Lácteos, Bebidas..."
                                           style="-fx-background-radius: 6; -fx-border-color: #a7f3d0;
                                                  -fx-border-radius: 6; -fx-padding: 6 10 6 10;
                                                  -fx-focus-color: #10b981;"
                                           GridPane.columnIndex="1" />

                                <Label text="Estado:" style="-fx-text-fill: #374151; -fx-font-weight: bold; -fx-font-size: 13px;"
                                       GridPane.columnIndex="2" />
                                <CheckBox fx:id="chkActiva" text="Activa"
                                          style="-fx-text-fill: #374151; -fx-font-size: 13px;"
                                          GridPane.columnIndex="3" />
                            </children>
                        </GridPane>
                    </children>
                </VBox>

                <!-- TABLA -->
                <TableView fx:id="tblCategorias" VBox.vgrow="ALWAYS"
                           style="-fx-background-radius: 10;
                                  -fx-border-color: #a7f3d0;
                                  -fx-border-radius: 10;
                                  -fx-border-width: 1.5;
                                  -fx-effect: dropshadow(three-pass-box, rgba(6,78,59,0.08), 8, 0, 0, 4);">
                    <columns>
                        <TableColumn fx:id="colId"     prefWidth="70.0"  text="ID" />
                        <TableColumn fx:id="colNombre" prefWidth="400.0" text="Nombre Categoría" />
                        <!-- colActiva: declarada para el binding pero oculta por solicitud del docente -->
                        <TableColumn fx:id="colActiva" prefWidth="0.0"   text="Activa" visible="false" />
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                </TableView>

            </children>
        </VBox>
    </center>
</BorderPane>