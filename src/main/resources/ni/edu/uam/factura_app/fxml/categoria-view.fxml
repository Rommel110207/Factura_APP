<?xml version="1.0" encoding="UTF-8"?>

import javafx.scene.control.*?>
import javafx.scene.layout.*?>
import javafx.geometry.Insets?>
import javafx.scene.text.Font?>

<VBox spacing="15.0" style="-fx-background-color: #f0fdf4;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ni.edu.uam.factura_app.controller.CategoriaController">
    <children>
        <!-- HEADER -->
        <HBox alignment="CENTER_LEFT" spacing="20.0" style="-fx-background-color: #064e3b; -fx-padding: 15 24 15 24;">
            <children>
                <Label text="Categorías" textFill="WHITE" style="-fx-font-size: 24px; -fx-font-weight: bold;" />
                <Region HBox.hgrow="ALWAYS" />
                <Button mnemonicParsing="false" onAction="#cerrar" text="Cerrar" style="-fx-background-color: #ef4444; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6; -fx-cursor: hand; -fx-padding: 6 16 6 16;" />
            </children>
        </HBox>

        <!-- TOOLBAR -->
        <HBox alignment="CENTER_LEFT" spacing="10.0" style="-fx-background-color: #065f46; -fx-padding: 10 24 10 24;">
            <children>
                <TextField fx:id="txtBuscar" prefWidth="260.0" promptText="Buscar por nombre..." style="-fx-background-radius: 20; -fx-border-color: #6ee7b7; -fx-border-radius: 20; -fx-padding: 5 12 5 12;" />
                <Button mnemonicParsing="false" onAction="#buscar" text="Buscar" style="-fx-background-color: #10b981; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 20; -fx-cursor: hand; -fx-padding: 6 14 6 14;" />
                <Region HBox.hgrow="ALWAYS" />
                <Button mnemonicParsing="false" onAction="#guardar" text="Guardar" style="-fx-background-color: #10b981; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6; -fx-cursor: hand; -fx-padding: 6 16 6 16;" />
                <Button mnemonicParsing="false" onAction="#limpiar" text="Limpiar" style="-fx-background-color: #6ee7b7; -fx-text-fill: #064e3b; -fx-font-weight: bold; -fx-background-radius: 6; -fx-cursor: hand; -fx-padding: 6 16 6 16;" />
                <Button mnemonicParsing="false" onAction="#eliminar" text="Eliminar" style="-fx-background-color: #fee2e2; -fx-text-fill: #dc2626; -fx-font-weight: bold; -fx-background-radius: 6; -fx-cursor: hand; -fx-padding: 6 16 6 16;" />
            </children>
        </HBox>

        <HBox spacing="15.0" VBox.vgrow="ALWAYS">
            <VBox.margin>
                <Insets bottom="15.0" left="15.0" right="15.0" />
            </VBox.margin>
            <children>
                <!-- FORM -->
                <VBox prefWidth="350.0" spacing="15.0" style="-fx-background-color: white; -fx-background-radius: 10; -fx-border-color: #d1fae5; -fx-border-radius: 10; -fx-padding: 20;">
                    <children>
                        <Label text="Datos de Categoría" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #064e3b;" />
                        <GridPane vgap="15.0" hgap="10.0">
                            <columnConstraints>
                                <ColumnConstraints hgrow="SOMETIMES" maxWidth="100.0" minWidth="10.0" prefWidth="80.0" />
                                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" />
                            </columnConstraints>
                            <rowConstraints>
                                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                            </rowConstraints>
                            <children>
                                <Label text="Nombre:" style="-fx-font-weight: bold; -fx-text-fill: #064e3b;" GridPane.rowIndex="0" />
                                <TextField fx:id="txtNombre" promptText="Nombre de categoría" style="-fx-background-radius: 5; -fx-border-color: #a7f3d0; -fx-border-radius: 5;" GridPane.columnIndex="1" GridPane.rowIndex="0" />
                                
                                <Label text="Estado:" style="-fx-font-weight: bold; -fx-text-fill: #064e3b;" GridPane.rowIndex="1" />
                                <CheckBox fx:id="chkActiva" text="Activa" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                            </children>
                        </GridPane>
                    </children>
                </VBox>

                <!-- TABLE -->
                <VBox HBox.hgrow="ALWAYS" style="-fx-background-color: white; -fx-background-radius: 10; -fx-border-color: #d1fae5; -fx-border-radius: 10; -fx-padding: 10;">
                    <children>
                        <TableView fx:id="tblCategorias" VBox.vgrow="ALWAYS" style="-fx-background-color: transparent;">
                            <columns>
                                <TableColumn fx:id="colId" prefWidth="70.0" text="ID" />
                                <TableColumn fx:id="colNombre" prefWidth="250.0" text="Nombre" />
                                <TableColumn fx:id="colActiva" prefWidth="100.0" text="Activa" />
                            </columns>
                            <placeholder>
                                <Label text="Tabla sin contenido" textFill="#9ca3af"/>
                            </placeholder>
                        </TableView>
                    </children>
                </VBox>
            </children>
        </HBox>
    </children>
</VBox>