<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<VBox spacing="15.0" style="-fx-background-color: #f4f6f9;" prefHeight="550.0" prefWidth="850.0"
      xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="ni.edu.uam.factura_app.controller.CategoriaController">
    <padding>
        <Insets top="20.0" right="20.0" bottom="20.0" left="20.0" />
    </padding>
    <children>
        <!-- Encabezado -->
        <HBox alignment="CENTER_LEFT" style="-fx-background-color: #ffffff; -fx-background-radius: 8; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 5, 0, 0, 2);">
            <padding>
                <Insets top="15.0" right="20.0" bottom="15.0" left="20.0" />
            </padding>
            <children>
                <VBox>
                    <children>
                        <Label text="Categorías de Productos" style="-fx-text-fill: #1e293b;">
                            <font>
                                <Font name="System Bold" size="20.0" />
                            </font>
                        </Label>
                        <Label text="Clasificación para la organización del inventario" style="-fx-text-fill: #64748b;">
                            <font>
                                <Font size="12.0" />
                            </font>
                        </Label>
                    </children>
                </VBox>
            </children>
        </HBox>

        <!-- Cuerpo Principal -->
        <HBox spacing="20.0" VBox.vgrow="ALWAYS">
            <children>
                <!-- Formulario (Izquierda) -->
                <VBox prefWidth="300.0" spacing="12.0" style="-fx-background-color: #ffffff; -fx-background-radius: 8; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 5, 0, 0, 2);">
                    <padding>
                        <Insets top="20.0" right="20.0" bottom="20.0" left="20.0" />
                    </padding>
                    <children>
                        <Label text="Datos de la Categoría" style="-fx-text-fill: #0f172a;">
                            <font>
                                <Font name="System Bold" size="14.0" />
                            </font>
                        </Label>

                        <VBox spacing="4.0">
                            <children>
                                <Label text="ID Categoria:" style="-fx-text-fill: #475569;" />
                                <TextField fx:id="txtId" disable="true" promptText="Auto-generado" style="-fx-background-radius: 5;" />
                            </children>
                        </VBox>

                        <VBox spacing="4.0">
                            <children>
                                <Label text="Nombre Categoría:" style="-fx-text-fill: #475569;" />
                                <TextField fx:id="txtNombre" promptText="Ej: Bebidas, Lácteos..." style="-fx-background-radius: 5;" />
                            </children>
                        </VBox>

                        <VBox spacing="4.0" VBox.vgrow="ALWAYS">
                            <children>
                                <Label text="Descripción:" style="-fx-text-fill: #475569;" />
                                <TextArea fx:id="txtDescripcion" prefHeight="100.0" promptText="Detalles adicionales de la categoría..." style="-fx-background-radius: 5;" wrapText="true" />
                            </children>
                        </VBox>

                        <!-- Botones de Acción -->
                        <VBox spacing="8.0" style="-fx-padding: 10 0 0 0;">
                            <children>
                                <Button fx:id="btnGuardar" maxWidth="1.7976931348623157E308" onAction="#guardar" text="💾 Guardar" style="-fx-background-color: #059669; -fx-text-fill: white; -fx-background-radius: 5; -fx-cursor: hand;">
                                    <font><Font name="System Bold" size="12.0" /></font>
                                </Button>
                                <HBox spacing="8.0">
                                    <children>
                                        <Button fx:id="btnLimpiar" maxWidth="1.7976931348623157E308" onAction="#limpiar" text="📄 Nuevo" HBox.hgrow="ALWAYS" style="-fx-background-color: #e2e8f0; -fx-text-fill: #475569; -fx-background-radius: 5; -fx-cursor: hand;" />
                                        <Button fx:id="btnEliminar" maxWidth="1.7976931348623157E308" onAction="#eliminar" text="🗑️ Eliminar" HBox.hgrow="ALWAYS" style="-fx-background-color: #fee2e2; -fx-text-fill: #dc2626; -fx-background-radius: 5; -fx-cursor: hand;" />
                                    </children>
                                </HBox>
                            </children>
                        </VBox>
                    </children>
                </VBox>

                <!-- Tabla de Registros (Derecha) -->
                <VBox HBox.hgrow="ALWAYS" spacing="10.0" style="-fx-background-color: #ffffff; -fx-background-radius: 8; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 5, 0, 0, 2);">
                    <padding>
                        <Insets top="15.0" right="15.0" bottom="15.0" left="15.0" />
                    </padding>
                    <children>
                        <TableView fx:id="tablaCategorias" VBox.vgrow="ALWAYS" style="-fx-background-radius: 5;">
                            <columns>
                                <TableColumn fx:id="colId" prefWidth="70.0" text="ID" />
                                <TableColumn fx:id="colNombre" prefWidth="180.0" text="Nombre Categoría" />
                                <TableColumn fx:id="colDescripcion" prefWidth="250.0" text="Descripción" />
                            </columns>
                            <columnResizePolicy>
                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                            </columnResizePolicy>
                        </TableView>
                    </children>
                </VBox>
            </children>
        </HBox>
    </children>
</VBox>