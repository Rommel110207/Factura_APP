<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.ToolBar?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="600.0" prefWidth="900.0" style="-fx-background-color: linear-gradient(to bottom right, #2b5876, #4e4376);" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ni.edu.uam.factura_app.controller.MenuPrincipalController">
   <top>
      <VBox BorderPane.alignment="CENTER">
         <children>
            <MenuBar style="-fx-background-color: rgba(255, 255, 255, 0.9);">
              <menus>
                <Menu mnemonicParsing="false" text="Archivo">
                  <items>
                    <MenuItem fx:id="mnuSalir" mnemonicParsing="false" onAction="#salir" text="Salir" />
                  </items>
                </Menu>
                <Menu mnemonicParsing="false" text="Catálogos">
                  <items>
                    <MenuItem fx:id="mnuProductos" mnemonicParsing="false" onAction="#abrirProductos" text="Productos" />
                  </items>
                </Menu>
              </menus>
            </MenuBar>
            <ToolBar prefHeight="40.0" prefWidth="200.0" style="-fx-background-color: rgba(255, 255, 255, 0.8);">
              <items>
                <Button fx:id="btnProductos" mnemonicParsing="false" onAction="#abrirProductos" style="-fx-background-color: #ff7e5f; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5;" text="Productos" />
                  <Button fx:id="btnSalir" mnemonicParsing="false" onAction="#salir" style="-fx-background-color: #feb47b; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5;" text="Salir" />
              </items>
            </ToolBar>
         </children>
      </VBox>
   </top>
   <center>
      <Label text="Sistema de Facturación" textFill="WHITE" BorderPane.alignment="CENTER">
         <font>
            <Font name="System Bold" size="48.0" />
         </font>
         <effect>
            <javafx.scene.effect.DropShadow color="#00000080" offsetX="3.0" offsetY="3.0" />
         </effect>
      </Label>
   </center>
</BorderPane>
